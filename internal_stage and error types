COPY INTO CORE_DB.CORE_SCHEMA.CUSTOMER_USER_STAGE
FROM @~
FILE_FORMAT = (TYPE = 'CSV' FIELD_OPTIONALLY_ENCLOSED_BY='"' SKIP_HEADER=1);



COPY INTO "CORE_DB"."CORE_SCHEMA"."CUSTOMER"
FROM (
    SELECT $1, $2, $3, $4, $5
    FROM @~ )
FILES = ('2025-07-19T14:01:31.660Z/Customer_data.txt')
FILE_FORMAT = (
    TYPE=CSV,
    SKIP_HEADER=1,
    FIELD_DELIMITER=',',
    TRIM_SPACE=TRUE,
    FIELD_OPTIONALLY_ENCLOSED_BY='"',
    REPLACE_INVALID_CHARACTERS=TRUE,
    DATE_FORMAT='MM/DD/YYYY',
    TIME_FORMAT=AUTO,
    TIMESTAMP_FORMAT=AUTO
