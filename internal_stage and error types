--How to load multiple files

copy into CORE_DB.CORE_SCHEMA.CUSTOMER_USER_STAGE
from @~
file_format = (TYPE = 'CSV' COMPRESSION = 'GZIP' FIELD_OPTIONALLY_ENCLOSED_BY='"' SKIP_HEADER=1)

--specify pattern

copy into CORE_DB.CORE_SCHEMA.CUSTOMER_USER_STAGE
from @~
file_format = (TYPE = 'CSV' COMPRESSION = 'GZIP' FIELD_OPTIONALLY_ENCLOSED_BY='"' SKIP_HEADER=1)
pattern = '.*.csv'
on_error = 'skip_file';


COPY INTO CORE_DB.CORE_SCHEMA.CUSTOMER_USER_STAGE
  FROM @~
  FILE_FORMAT = (TYPE = 'CSV' COMPRESSION = 'GZIP' FIELD_OPTIONALLY_ENCLOSED_BY='"' SKIP_HEADER=1)
  PATTERN='.*Customer_data_file_[1-5].csv.gz'
  ON_ERROR = 'skip_file'
  --PURGE=TRUE; 
  
  
COPY INTO CORE_DB.CORE_SCHEMA.CUSTOMER_USER_STAGE
  FROM @~
  FILE_FORMAT = (TYPE = 'CSV' COMPRESSION = 'GZIP' FIELD_OPTIONALLY_ENCLOSED_BY='"' SKIP_HEADER=1)
  PATTERN='.*Customer_data_file_[1-5].csv.gz'
  ON_ERROR = 'skip_file'
